# Halty Backend — первые API-запросы
# Архитектура по образцу uplift-backend (Strapi 4 → адаптировано под Strapi 5)
#
# UpLift mapping:
#   exercise   → vacancy
#   favorite   → application (owner-scoped)
#   /exercises/search → /vacancies/search
#   spatial    → /vacancies/nearby
#
# Base URL (local):
@baseUrl = http://localhost:1337
@api = {{baseUrl}}/api
#
# Запуск всего файла целиком:  httpyac send docs/REQUESTS.http --all
# (в Docker: make docker-test). Запросы пронумерованы и выполняются по порядку,
# ответы предыдущих запросов переиспользуются через `# @ref <name>`.
#
# Тестовые креды:
#   user:  test@halty.by / Test1234!   (регистрируется запросом 6)
#   admin: admin@halty.by / admin2026  (сидируется бутстрапом Strapi)

### ─── Health check (как strapiClient.checkHealth) ─────────────────
GET {{api}}/vacancies?pagination[pageSize]=1

?? status == 200

### ─── 1. Публичный контент: список вакансий ───────────────────────
# Аналог: GET /api/exercises?locale=en&populate=*
# @name vacancies
GET {{api}}/vacancies?populate=*&pagination[pageSize]=100

?? status == 200

### ─── 2. Фильтр по категории ───────────────────────────────────────
# Аналог: GET /api/categories?filters[filterType][$eq]=fitness
GET {{api}}/vacancies?filters[category][$eq]=parks_green&populate=*

?? status == 200

### ─── 3. Поиск по тексту (custom route) ───────────────────────────
# Аналог: GET /api/exercises/search?search=full+body
GET {{api}}/vacancies/search?search=парк&pagination[page]=1&pagination[pageSize]=20

?? status == 200

### ─── 4. Вакансии рядом (spatial, custom route) ───────────────────
GET {{api}}/vacancies/nearby?lat=53.9045&lng=27.5615&radius=3000

?? status == 200

### ─── 4.1. Список: фильтр по категории (filters[category][$eq]) ───
# @name vacanciesByCategoryFilter
GET {{api}}/vacancies?filters[category][$eq]=horeca&pagination[pageSize]=100

?? status == 200
?? js response.parsedBody.data.length >= 1
?? js response.parsedBody.data.every(v => v.category == 'horeca') isTrue
?? js response.parsedBody.meta.pagination.total == response.parsedBody.data.length isTrue

### ─── 4.2. Список: короткий alias ?category= ──────────────────────
GET {{api}}/vacancies?category=parks_green&pagination[pageSize]=100

?? status == 200
?? js response.parsedBody.data.length >= 1
?? js response.parsedBody.data.every(v => v.category == 'parks_green') isTrue

### ─── 4.3. Список: поиск через ?search= ───────────────────────────
GET {{api}}/vacancies?search=парк&pagination[pageSize]=100

?? status == 200
?? js response.parsedBody.data.length >= 1
?? js response.parsedBody.data.every(v => [v.title, v.company, v.locationName].join(' ').toLowerCase().includes('парк')) isTrue

### ─── 4.4. Список: пагинация, первая страница ─────────────────────
# @name vacanciesPagedFirst
GET {{api}}/vacancies?pagination[page]=1&pagination[pageSize]=1

?? status == 200
?? js response.parsedBody.data.length == 1
?? js response.parsedBody.meta.pagination.page == 1
?? js response.parsedBody.meta.pagination.pageSize == 1
?? js response.parsedBody.meta.pagination.pageCount == response.parsedBody.meta.pagination.total isTrue

### ─── 4.5. Список: пагинация, вторая страница ─────────────────────
GET {{api}}/vacancies?pagination[page]=2&pagination[pageSize]=1

?? status == 200
?? js response.parsedBody.data.length == 1
?? js response.parsedBody.meta.pagination.page == 2
?? js response.parsedBody.meta.pagination.pageSize == 1

### ─── 4.6. Список: пагинация через alias ?limit= ──────────────────
GET {{api}}/vacancies?limit=1&start=1

?? status == 200
?? js response.parsedBody.data.length == 1
?? js response.parsedBody.meta.pagination.pageSize == 1

### ─── 4.7. Список: нецелая страница отклоняется ───────────────────
GET {{api}}/vacancies?pagination[page]=2.5

?? status == 400
?? js response.parsedBody.error.message contains pagination[page]

### ─── 4.8. Список: нулевая страница отклоняется ───────────────────
GET {{api}}/vacancies?pagination[page]=0

?? status == 400
?? js response.parsedBody.error.message contains pagination[page]

### ─── 4.9. Список: нулевой pageSize отклоняется ───────────────────
GET {{api}}/vacancies?pagination[pageSize]=0

?? status == 400
?? js response.parsedBody.error.message contains pagination[pageSize]

### ─── 4.10. Список: отрицательный start отклоняется ────────────────
GET {{api}}/vacancies?pagination[start]=-1

?? status == 400
?? js response.parsedBody.error.message contains pagination[start]

### ─── 4.11. Nearby: фильтр по категории ────────────────────────────
# @name nearbyByCategory
GET {{api}}/vacancies/nearby?lat=53.9045&lng=27.5615&radius=5000&category=horeca

?? status == 200
?? js response.parsedBody.data.length >= 1
?? js response.parsedBody.data.every(v => v.category == 'horeca') isTrue

### ─── 4.12. Nearby: категория через filters[category][$eq] ─────────
GET {{api}}/vacancies/nearby?lat=53.9045&lng=27.5615&radius=5000&filters[category][$eq]=parks_green

?? status == 200
?? js response.parsedBody.data.length >= 1
?? js response.parsedBody.data.every(v => v.category == 'parks_green') isTrue

### ─── 5. Одна вакансия (documentId берём из списка выше) ──────────
# @ref vacancies
GET {{api}}/vacancies/{{vacancies.data[0].documentId}}?populate=*

?? status == 200

### ─── 6. Регистрация пользователя ─────────────────────────────────
# Аналог UpLift: POST /api/auth/local/register
# @name registerUser
POST {{api}}/auth/local/register
Content-Type: application/json

{
  "username": "testuser",
  "email": "test@halty.by",
  "password": "Test1234!",
  "accountRole": "user"
}

### ─── 7. Логин пользователя ───────────────────────────────────────
# Аналог UpLift: POST /api/auth/local
# @name login
POST {{api}}/auth/local
Content-Type: application/json

{
  "identifier": "test@halty.by",
  "password": "Test1234!"
}

?? status == 200

### ─── 7b. Логин админа (сидируется бутстрапом) ────────────────────
# @name adminLogin
POST {{api}}/auth/local
Content-Type: application/json

{
  "identifier": "admin@halty.by",
  "password": "admin2026"
}

?? status == 200

### ─── 8. Текущий пользователь ─────────────────────────────────────
# Аналог UpLift: GET /api/users/me
# @ref login
GET {{api}}/users/me
Authorization: Bearer {{login.jwt}}

?? status == 200

### ─── 9. Создать вакансию (admin — публикуется сразу) ──────────────
# @name createVacancy
# @ref adminLogin
POST {{api}}/vacancies
Authorization: Bearer {{adminLogin.jwt}}
Content-Type: application/json

{
  "data": {
    "title": "Курьер на велосипеде",
    "company": "FastDelivery",
    "salary": "90 BYN / смена",
    "category": "delivery",
    "categoryLabel": "Доставка",
    "attachmentType": "ground_zone",
    "lat": 53.9102,
    "lng": 27.5678,
    "locationName": "ул. Немига",
    "description": "Доставка заказов по центру города.",
    "requirements": ["Велосипед", "Смартфон"],
    "schedule": "Гибкий",
    "payoutType": "Ежедневно",
    "color": "#3b82f6",
    "accentColor": "#1e3a8a",
    "iconType": "delivery"
  }
}

?? status == 200

### ─── 10. Откликнуться на вакансию (owner-scoped) ───────────────────
# Аналог UpLift: POST /api/favorites { data: { exercise: 123 } }
# @name createApplication
# @ref login
# @ref createVacancy
POST {{api}}/applications
Authorization: Bearer {{login.jwt}}
Content-Type: application/json

{
  "data": {
    "vacancy": "{{createVacancy.data.documentId}}",
    "role": "Смена",
    "company": "Минскзеленстрой",
    "location": "Сквер Адама Міцкевіча",
    "lat": 53.8988,
    "lng": 27.5492,
    "salary": "1 650 – 2 100 BYN",
    "scheduleDate": "Сегодня с 10:00",
    "duration": "8 часов",
    "walkTime": "~10 минут пешком",
    "description": "Уход за зелеными насаждениями.",
    "color": "#4ade80",
    "progressStep": 1,
    "status": "pending",
    "statusLabel": "Ожидает",
    "requirementsNotes": ["Паспорт гражданина / ВНЖ"]
  }
}

?? status == 200

### ─── 11. Мои отклики (только свои, owner filter) ───────────────────
# Аналог UpLift: GET /api/favorites?populate[exercise]=*
# @ref login
GET {{api}}/applications?populate=*
Authorization: Bearer {{login.jwt}}

?? status == 200

### ─── 12. Статусы/шаги отклика: права ролей ────────────────────────
# Исполнитель может только cancelled и не может менять шаг.
# Работодатель своей вакансии и админ — статусы reviewing/active/rejected/completed, шаги 2–5.

### ─── 12.0. Регистрация работодателя ────────────────────────────────
# @name registerEmployer
POST {{api}}/auth/local/register
Content-Type: application/json

{
  "username": "employer",
  "email": "employer@halty.by",
  "password": "Test1234!",
  "accountRole": "employer",
  "companyName": "Минскзеленстрой"
}

?? status == 200

### ─── 12.1. Логин работодателя ──────────────────────────────────────
# @name employerLogin
POST {{api}}/auth/local
Content-Type: application/json

{
  "identifier": "employer@halty.by",
  "password": "Test1234!"
}

?? status == 200

### ─── 12.2. Работодатель создаёт свою вакансию ──────────────────────
# @name createEmployerVacancy
# @ref employerLogin
POST {{api}}/vacancies
Authorization: Bearer {{employerLogin.jwt}}
Content-Type: application/json

{
  "data": {
    "title": "Тестовая смена работодателя",
    "company": "Минскзеленстрой",
    "salary": "100 BYN / смена",
    "category": "parks_green",
    "categoryLabel": "Озеленение",
    "attachmentType": "ground_zone",
    "lat": 53.9,
    "lng": 27.55,
    "locationName": "Тестовая локация",
    "description": "Вакансия для проверки прав на статусы.",
    "schedule": "Сегодня",
    "payoutType": "Ежедневно"
  }
}

?? status == 200

### ─── 12.3. Админ публикует вакансию работодателя ───────────────────
# @ref adminLogin
# @ref createEmployerVacancy
PATCH {{api}}/vacancies/{{createEmployerVacancy.data.documentId}}/moderation
Authorization: Bearer {{adminLogin.jwt}}
Content-Type: application/json

{
  "status": "published"
}

?? status == 200

### ─── 12.4. Исполнитель откликается на вакансию работодателя ────────
# @name createEmployerApplication
# @ref login
# @ref createEmployerVacancy
POST {{api}}/applications
Authorization: Bearer {{login.jwt}}
Content-Type: application/json

{
  "data": {
    "vacancy": "{{createEmployerVacancy.data.documentId}}"
  }
}

?? status == 200

### ─── 12.5. Исполнитель может отменить свой отклик ───────────────────
# @ref login
# @ref createEmployerApplication
PUT {{api}}/applications/{{createEmployerApplication.data.documentId}}
Authorization: Bearer {{login.jwt}}
Content-Type: application/json

{
  "data": {
    "status": "cancelled"
  }
}

?? status == 200
?? js response.parsedBody.data.status == cancelled
?? js response.parsedBody.data.statusLabel == Отказ

### ─── 12.6. Исполнитель не может поставить active ────────────────────
# @ref login
# @ref createEmployerApplication
PUT {{api}}/applications/{{createEmployerApplication.data.documentId}}
Authorization: Bearer {{login.jwt}}
Content-Type: application/json

{
  "data": {
    "status": "active"
  }
}

?? status == 403
?? js response.parsedBody.error.message == Исполнитель может только отменить отклик

### ─── 12.7. Исполнитель не может поставить шаг 5 ────────────────────
# @ref login
# @ref createEmployerApplication
PUT {{api}}/applications/{{createEmployerApplication.data.documentId}}
Authorization: Bearer {{login.jwt}}
Content-Type: application/json

{
  "data": {
    "progressStep": 5
  }
}

?? status == 403
?? js response.parsedBody.error.message == Исполнитель не может менять шаг отклика

### ─── 12.8. Негативные попытки не изменили отклик ───────────────────
# @ref login
# @ref createEmployerApplication
GET {{api}}/applications/{{createEmployerApplication.data.documentId}}
Authorization: Bearer {{login.jwt}}

?? status == 200
?? js response.parsedBody.data.status == cancelled
?? js response.parsedBody.data.progressStep == 1

### ─── 12.9. Работодатель своей вакансии: reviewing + шаг 2 ───────────
# @ref employerLogin
# @ref createEmployerApplication
PUT {{api}}/applications/{{createEmployerApplication.data.documentId}}
Authorization: Bearer {{employerLogin.jwt}}
Content-Type: application/json

{
  "data": {
    "status": "reviewing",
    "progressStep": 2
  }
}

?? status == 200
?? js response.parsedBody.data.status == reviewing
?? js response.parsedBody.data.progressStep == 2

### ─── 12.10. Работодатель своей вакансии: active + шаг 3 ─────────────
# @ref employerLogin
# @ref createEmployerApplication
PUT {{api}}/applications/{{createEmployerApplication.data.documentId}}
Authorization: Bearer {{employerLogin.jwt}}
Content-Type: application/json

{
  "data": {
    "status": "active",
    "progressStep": 3
  }
}

?? status == 200
?? js response.parsedBody.data.status == active
?? js response.parsedBody.data.progressStep == 3

### ─── 12.11. Работодатель своей вакансии: rejected + шаг 4 ───────────
# @ref employerLogin
# @ref createEmployerApplication
PUT {{api}}/applications/{{createEmployerApplication.data.documentId}}
Authorization: Bearer {{employerLogin.jwt}}
Content-Type: application/json

{
  "data": {
    "status": "rejected",
    "progressStep": 4
  }
}

?? status == 200
?? js response.parsedBody.data.status == rejected
?? js response.parsedBody.data.progressStep == 4

### ─── 12.12. Работодатель своей вакансии: completed + шаг 5 ──────────
# @ref employerLogin
# @ref createEmployerApplication
PUT {{api}}/applications/{{createEmployerApplication.data.documentId}}
Authorization: Bearer {{employerLogin.jwt}}
Content-Type: application/json

{
  "data": {
    "status": "completed",
    "progressStep": 5
  }
}

?? status == 200
?? js response.parsedBody.data.status == completed
?? js response.parsedBody.data.progressStep == 5

### ─── 12.13. Работодатель не может поставить pending ─────────────────
# @ref employerLogin
# @ref createEmployerApplication
PUT {{api}}/applications/{{createEmployerApplication.data.documentId}}
Authorization: Bearer {{employerLogin.jwt}}
Content-Type: application/json

{
  "data": {
    "status": "pending"
  }
}

?? status == 403
?? js response.parsedBody.error.message == Работодатель может устанавливать только статусы: reviewing, active, rejected, completed

### ─── 12.14. Работодатель не может поставить шаг 1 ───────────────────
# @ref employerLogin
# @ref createEmployerApplication
PUT {{api}}/applications/{{createEmployerApplication.data.documentId}}
Authorization: Bearer {{employerLogin.jwt}}
Content-Type: application/json

{
  "data": {
    "progressStep": 1
  }
}

?? status == 403
?? js response.parsedBody.error.message == Работодатель может устанавливать шаг от 2 до 5

### ─── 12.15. Работодатель не может поставить шаг 6 ───────────────────
# @ref employerLogin
# @ref createEmployerApplication
PUT {{api}}/applications/{{createEmployerApplication.data.documentId}}
Authorization: Bearer {{employerLogin.jwt}}
Content-Type: application/json

{
  "data": {
    "progressStep": 6
  }
}

?? status == 403
?? js response.parsedBody.error.message == Работодатель может устанавливать шаг от 2 до 5

### ─── 12.16. Работодатель не может менять чужую вакансию ─────────────
# Компания совпадает, поэтому отклик доступен, но вакансия принадлежит админу.
# @ref employerLogin
# @ref createApplication
PUT {{api}}/applications/{{createApplication.data.documentId}}
Authorization: Bearer {{employerLogin.jwt}}
Content-Type: application/json

{
  "data": {
    "status": "active"
  }
}

?? status == 403
?? js response.parsedBody.error.message == Менять статус может только работодатель этой вакансии

### ─── 12.17. Админ может менять статус и шаг через PUT ────────────────
# @ref adminLogin
# @ref createApplication
PUT {{api}}/applications/{{createApplication.data.documentId}}
Authorization: Bearer {{adminLogin.jwt}}
Content-Type: application/json

{
  "data": {
    "status": "completed",
    "progressStep": 5
  }
}

?? status == 200
?? js response.parsedBody.data.status == completed
?? js response.parsedBody.data.progressStep == 5

### ─── 13. Обновить статус отклика (admin) ──────────────────────────
# @ref adminLogin
# @ref createApplication
PATCH {{api}}/applications/{{createApplication.data.documentId}}/status
Authorization: Bearer {{adminLogin.jwt}}
Content-Type: application/json

{
    "status": "rejected",
    "rejectionReason": "Не по вайбу",
    "step": 2
}

?? status == 200

### ─── 14. Получить отклики ─────────────────────────────────────────
# @ref login
GET {{api}}/applications
Authorization: Bearer {{login.jwt}}
Content-Type: application/json

?? status == 200

### ─── 15. Исполнитель не может подменить senderRole в теле ──────────
# Роль берётся из JWT (ctx.state.user), а не из запроса: подделанный
# senderRole: "admin" не должен сделать сообщение сообщением работодателя.
# @ref login
# @ref createApplication
POST {{api}}/applications/{{createApplication.data.documentId}}/messages
Authorization: Bearer {{login.jwt}}
Content-Type: application/json

{
    "text": "Тестовое сообщение по отклику",
    "senderRole": "admin",
    "senderName": "Илья"
}

?? status == 200
?? js response.parsedBody.data.from == user

### ─── 15.1. Сообщение исполнителя сохранено как user ─────────────────
# @ref login
# @ref createApplication
GET {{api}}/applications/{{createApplication.data.documentId}}
Authorization: Bearer {{login.jwt}}

?? status == 200
?? js response.parsedBody.data.messages.find(m => m.text == 'Тестовое сообщение по отклику').from == user

### ─── 15.2. Работодатель: роль из JWT, подмена на user игнорируется ──
# @ref employerLogin
# @ref createEmployerApplication
POST {{api}}/applications/{{createEmployerApplication.data.documentId}}/messages
Authorization: Bearer {{employerLogin.jwt}}
Content-Type: application/json

{
    "text": "Сообщение работодателя",
    "senderRole": "user"
}

?? status == 200
?? js response.parsedBody.data.from == employer

### ─── 15.3. Админ: сообщение уходит как от работодателя ──────────────
# @ref adminLogin
# @ref createApplication
POST {{api}}/applications/{{createApplication.data.documentId}}/messages
Authorization: Bearer {{adminLogin.jwt}}
Content-Type: application/json

{
    "text": "Сообщение администратора"
}

?? status == 200
?? js response.parsedBody.data.from == employer

### ─── 16. PUT /users/:id — whitelist полей, нельзя стать админом ───
# Разрешены только displayName, phone, tgUsername, tgConnected, companyName.
# accountRole, role, email и username должны игнорироваться.
# @name updateOwnProfile
# @ref login
PUT {{api}}/users/{{login.user.id}}
Authorization: Bearer {{login.jwt}}
Content-Type: application/json

{
  "displayName": "Test User Updated",
  "phone": "+375291234567",
  "tgUsername": "testuser_tg",
  "tgConnected": true,
  "companyName": "Test Company",
  "accountRole": "admin",
  "role": 2,
  "email": "attacker@halty.by",
  "username": "attacker"
}

?? status == 200
?? js response.parsedBody.displayName == Test User Updated
?? js response.parsedBody.phone == +375291234567
?? js response.parsedBody.tgUsername == testuser_tg
?? js response.parsedBody.tgConnected == true
?? js response.parsedBody.companyName == Test Company
?? js response.parsedBody.accountRole != admin
?? js response.parsedBody.email == test@halty.by
?? js response.parsedBody.username == testuser

### ─── 17. PUT /users/:id — нельзя обновить чужой профиль ───────────
# @ref login
# @ref adminLogin
PUT {{api}}/users/{{adminLogin.user.id}}
Authorization: Bearer {{login.jwt}}
Content-Type: application/json

{
  "displayName": "Hacked Admin"
}

?? status == 404
### ─── 18. PUT /api/vacancies/:id — только владелец, системные поля защищены ──
# Update включён на core-роутере для authenticated, поэтому проверки живут в
# контроллере: работодатель меняет только свою вакансию и только бизнес-поля.
# moderationStatus/owner/createdByRole из тела игнорируются, модерация — только
# через PATCH /vacancies/:id/moderation.

### ─── 18.0. Второй работодатель (для проверки чужой вакансии) ────────
# @name registerEmployer2
POST {{api}}/auth/local/register
Content-Type: application/json

{
  "username": "employer2",
  "email": "employer2@halty.by",
  "password": "Test1234!",
  "accountRole": "employer",
  "companyName": "Другая компания"
}

?? status == 200

### ─── 18.1. Логин второго работодателя ──────────────────────────────
# @name employer2Login
POST {{api}}/auth/local
Content-Type: application/json

{
  "identifier": "employer2@halty.by",
  "password": "Test1234!"
}

?? status == 200

### ─── 18.2. Работодатель создаёт вакансию для редактирования ────────
# @name vacancyToEdit
# @ref employerLogin
POST {{api}}/vacancies
Authorization: Bearer {{employerLogin.jwt}}
Content-Type: application/json

{
  "data": {
    "title": "Вакансия до редактирования",
    "company": "Минскзеленстрой",
    "salary": "100 BYN / смена",
    "category": "parks_green",
    "categoryLabel": "Озеленение",
    "attachmentType": "ground_zone",
    "lat": 53.9,
    "lng": 27.55,
    "locationName": "Локация до редактирования",
    "description": "Проверка прав на редактирование.",
    "schedule": "Сегодня",
